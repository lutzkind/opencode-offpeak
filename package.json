{
  "name": "opencode-offpeak",
  "version": "0.3.1",
  "description": "Queue OpenCode agent tasks, guard peak pricing, and configure independent CLI and Desktop protection.",
  "author": "Lutz Kind",
  "license": "MIT",
  "type": "module",
  "main": "./src/server.ts",
  "engines": {
    "node": ">=22",
    "opencode": ">=2.0.26 <2.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "bun": "./src/server.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "bun": "./src/server.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "bun": "./tui.ts",
      "import": "./dist/tui.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "types": "./dist/server.d.ts",
  "files": [
    "src",
    "dist",
    "index.ts",
    "tui.ts",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "ARCHITECTURE.md",
    "DECISIONS.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.build.json && npm run build:gui",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src test vite.config.ts",
    "format": "biome format --write src test",
    "test": "npm run compile && node --test --test-force-exit --test-concurrency=1 test/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "build:gui": "vite build"
  },
  "keywords": [
    "opencode",
    "opencode-v2",
    "opencode-cli",
    "opencode-go",
    "deepseek",
    "off-peak-inference",
    "agent-queue",
    "llm-cost-optimization",
    "ai-coding-cost",
    "pause-resume-agent",
    "opencode-desktop",
    "opencode-gui",
    "peak-pricing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lutzkind/opencode-offpeak.git"
  },
  "bugs": {
    "url": "https://github.com/lutzkind/opencode-offpeak/issues"
  },
  "homepage": "https://github.com/lutzkind/opencode-offpeak#readme",
  "dependencies": {
    "@opencode/plugin": "2.3.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.12.2",
    "solid-js": "1.9.12",
    "typescript": "5.8.2",
    "vite": "7.3.8",
    "vite-plugin-solid": "2.11.16"
  },
  "peerDependencies": {
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  }
}
